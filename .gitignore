# Dépendances et build
node_modules/
dist/
# Cache incrémental de `tsc -b` : un artefact de build, régénéré à chaque
# compilation. Versionné jusqu'au 2026-08-31 — il se salissait à chaque
# `npm run lint` et se retrouvait committé au hasard ; pire, la CI repartait
# du cache d'un autre poste au lieu de tout revérifier.
*.tsbuildinfo

# Environnement local — jamais versionné
.env
.env.local
.env.*.local

# Logs et divers
npm-debug.log*
*.log

# Supabase CLI (état local)
supabase/.temp/
supabase/.branches/

# Artefacts de tests navigateur (Playwright MCP)
.playwright-mcp/
parcours-agent-liste.png

# Éditeurs / OS
.DS_Store
Thumbs.db

# Secrets locaux (jamais versionnes)
.secrets/

# État local de wrangler (wrangler dev)
.wrangler/
